rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Final GPX files, written only by the server (POST /api/routes copies them here).
    match /routes/{file} {
      allow read: if true;
    }

    // Temporary uploads; removed by the server after processing, or by the lifecycle rule after 1 day.
    match /uploads/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && file.matches('.*[.][gG][pP][xX]$');
    }
  }
}
