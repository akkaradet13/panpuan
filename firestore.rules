rules_version = '2';

// Client is read-only. Every write goes through Route Handlers with firebase-admin (which bypasses rules).
// Rules are not filters: client queries must include the same status conditions as below.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /clubs/{id} {
      allow read: if resource.data.status != 'suspended';
    }
    match /routes/{id} {
      allow read: if resource.data.status != 'suspended';
    }
    match /routes_reviews/{id} {
      allow read: if true;
    }
    match /rides/{id} {
      allow read: if resource.data.club_status != 'suspended';
    }
    match /rides_participants/{id} {
      allow read: if signedIn();
    }
    match /club_members/{id} {
      allow read: if signedIn();
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    // notify_* and anything else: no client access.
  }
}
